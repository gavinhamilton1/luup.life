# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=luup-photos
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Frontend (for CORS)
FRONTEND_URL=https://luup.life

# Session signing
SECRET_KEY=change-me-in-production

# Session TTL (in seconds, default 48h)
SESSION_TTL_SECONDS=172800

# Web Push (VAPID). Leave blank to disable push.
# Generate with: python -m py_vapid --gen  (produces private/public keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@luup.life
